# =============================================================================
# Poker Tracker — environment configuration template
# =============================================================================
# Copy this file to an uncommitted env file and fill in real values:
#   - Local:  create `.env` (used by docker compose locally)
#   - Dev VM: create `.env.dev` on the server
#   - Prod VM: create `.env.prod` on the server
#
# NEVER commit a filled-in copy. Real .env files are gitignored.
# All secrets (bot tokens) come from here, never from source control.
#
# .NET maps double-underscore (__) to nested configuration keys, so
# TelegramAuth__PublicBotToken sets TelegramAuth:PublicBotToken.
# =============================================================================

# --- ASP.NET Core environment -----------------------------------------------
# Development | Staging | Production. Deployed envs use Staging or Production.
ASPNETCORE_ENVIRONMENT=Production

# --- Telegram bot tokens (SECRET — from @BotFather) --------------------------
# Token for the PUBLIC Mini App's bot (validates public frontend initData).
# Real tokens look like <digits>:<35+ chars>. Fill in from BotFather.
TelegramAuth__PublicBotToken=REPLACE_WITH_PUBLIC_BOT_TOKEN
# Token for the ADMIN Mini App's bot (validates admin frontend initData).
TelegramAuth__AdminBotToken=REPLACE_WITH_ADMIN_BOT_TOKEN

# --- Bootstrap admin(s) ------------------------------------------------------
# Comma-separated Telegram numeric user id(s) seeded as admins on first start,
# so you can reach the admin app initially. Manage everyone else from the admin UI.
# Find your id by messaging the bot (/start) or a utility bot like @userinfobot.
TelegramAuth__BootstrapAdminIds=111111111

# --- initData freshness ------------------------------------------------------
# Max age in seconds of a Telegram initData payload before it is rejected.
TelegramAuth__InitDataMaxAgeSeconds=86400

# --- Bot webhook secret (SECRET) ---------------------------------------------
# Random string that forms part of the webhook URL path:
#   https://<api-domain>/bot/<public|admin>/webhook/<this-secret>
# Configure each bot's webhook to that URL (see the runbook). If empty, the
# webhook endpoint is disabled. Generate with: openssl rand -hex 32
TelegramAuth__WebhookSecret=REPLACE_WITH_RANDOM_SECRET

# --- Dev-only mock auth (MUST stay false/unset in deployed envs) -------------
# When true, the API accepts a mock identity instead of real Telegram initData.
# Only for local development. The app refuses to start if this is true in
# Staging/Production.
TelegramAuth__AllowDevMockAuth=false
TelegramAuth__DevMockUserId=1

# --- CORS allowed origins ----------------------------------------------------
# Exact frontend origin(s) allowed to call the API. Indexed env-var array form.
# Use the real deployed domains for each environment.
Cors__AllowedOrigins__0=https://poker.example.com
Cors__AllowedOrigins__1=https://admin.poker.example.com

# --- Database ----------------------------------------------------------------
# SQLite connection string. In containers this points at the mounted volume path.
ConnectionStrings__Sqlite=Data Source=/data/poker.db
