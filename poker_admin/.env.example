# Admin frontend environment template. Copy to .env.local (gitignored) for local dev,
# or set these at build time in CI/Docker for deployed environments.

# Base URL the SPA uses for API calls. Default "/api" works behind the Vite dev proxy
# and the Caddy reverse proxy.
VITE_API_BASE_URL=/api

# Local-only: run the admin app in a plain browser without Telegram (API dev-mock auth
# then accepts the request as the mock user). MUST be false/unset for real builds.
VITE_DEV_MOCK_AUTH=false
VITE_DEV_INIT_DATA=
