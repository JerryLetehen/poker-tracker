# Public frontend environment template. Copy to .env.local (gitignored) for local dev,
# or set these at build time in CI/Docker for deployed environments.

# Base URL the SPA uses for API calls. Default "/api" works behind the Vite dev proxy
# and the Caddy reverse proxy. Set to a full origin only if the API is cross-origin.
VITE_API_BASE_URL=/api

# Local-only: run the app in a plain browser without Telegram by sending no initData
# (the API's dev-mock auth then accepts the request). MUST be false/unset for real builds.
VITE_DEV_MOCK_AUTH=false
# Optional raw initData string to send in dev (usually leave empty).
VITE_DEV_INIT_DATA=
